# ReadySupply Environment Configuration

# Server Port (default 5000)
PORT=5000

# MongoDB Connection String (leave empty to use embedded in-memory mongodb-memory-server)
MONGODB_URI=

# JWT Secret and Expiration (used for httpOnly session cookies)
JWT_SECRET=readysupply_super_secure_jwt_secret_dev_key_2026_xyz!
JWT_EXPIRES_IN=7d

# Allowed Client Origin (for CORS and credentials)
CLIENT_URL=http://localhost:5173

# Storage Driver: local | s3
STORAGE_DRIVER=local

# Maximum File Upload Size in Megabytes
MAX_FILE_MB=10

# Warning threshold for expiring documents in days (default 30)
EXPIRY_WARNING_DAYS=30

# Initial Platform Administrator Seed Credentials
ADMIN_EMAIL=admin@readysupply.in
ADMIN_PASSWORD=Admin@ReadySupply2026!

# Whether to auto-seed demo data if database is empty (true/false)
SEED_DEMO=true

